# Copy to .env and fill in real values.
#   cp springboot-app/.env.example springboot-app/.env
# For the Docker MySQL (docker-compose.yml), DB_USERNAME=root and
# DB_PASSWORD must match MYSQL_ROOT_PASSWORD (default Milomilo112).

# Database
DB_URL=jdbc:mysql://localhost:3306/community_forum
DB_USERNAME=root
DB_PASSWORD=change-me

# JWT signing secret - use a long random string
JWT_SECRET=change-me-to-a-long-random-string

# RabbitMQ (only used if you enable the WS relay / messaging broker)
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest

# SMTP mail (used for email verification / password reset)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password